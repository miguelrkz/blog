---
import { url } from '../utils/url';

interface Props {
  currentPage: number;
  totalPages: number;
  prevUrl?: string;
  nextUrl?: string;
  baseUrl: string; // e.g. "" for home, or "/section/engineering"
}

const { currentPage, totalPages, prevUrl, nextUrl, baseUrl } = Astro.props;

if (totalPages <= 1) {
  // If there's only 1 page, don't show pagination
  // (unless totalPages is 0, which is also <= 1)
}

// Generate page links array
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);

function getPageUrl(pageNum: number): string {
  if (pageNum === 1) {
    return url(baseUrl === '' ? '/' : baseUrl);
  }
  // For page 2+, if baseUrl is empty: /page/2, if baseUrl is /section/engineering: /section/engineering/2
  const prefix = baseUrl === '' ? '/page' : `${baseUrl}`;
  return url(`${prefix}/${pageNum}`);
}
---

{totalPages > 1 && (
  <nav aria-label="Pagination" class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 py-4 border-t border-brand-light-border dark:border-brand-dark-border text-xs font-mono">
    <!-- Status / Info -->
    <div class="text-brand-grey-500 dark:text-brand-grey-400">
      <span class="text-brand-red dark:text-brand-red-neon font-semibold">[INDEX]</span> PAGE {currentPage} OF {totalPages}
    </div>

    <!-- Page Number Navigation Buttons -->
    <div class="flex items-center gap-1.5">
      <!-- Previous Button -->
      {prevUrl ? (
        <a
          href={prevUrl.startsWith('http') ? prevUrl : url(prevUrl)}
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded border border-brand-light-border dark:border-brand-dark-border bg-brand-light-surface dark:bg-brand-dark-surface hover:border-brand-red dark:hover:border-brand-red-neon text-brand-grey-800 dark:text-brand-grey-200 transition-colors"
          aria-label="Previous Page"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>PREV</span>
        </a>
      ) : (
        <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded border border-brand-light-border/40 dark:border-brand-dark-border/40 text-brand-grey-400 dark:text-brand-grey-600 cursor-not-allowed select-none">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>PREV</span>
        </span>
      )}

      <!-- Number buttons -->
      <div class="flex items-center gap-1">
        {pages.map((p) => {
          const isCurrent = p === currentPage;
          return isCurrent ? (
            <span
              class="w-8 h-8 rounded flex items-center justify-center font-bold bg-brand-red dark:bg-brand-red-neon text-white shadow-glow-red-sm select-none"
              aria-current="page"
            >
              {p}
            </span>
          ) : (
            <a
              href={getPageUrl(p)}
              class="w-8 h-8 rounded flex items-center justify-center border border-brand-light-border dark:border-brand-dark-border bg-brand-light-surface dark:bg-brand-dark-surface hover:border-brand-red dark:hover:border-brand-red-neon text-brand-grey-800 dark:text-brand-grey-200 transition-colors"
            >
              {p}
            </a>
          );
        })}
      </div>

      <!-- Next Button -->
      {nextUrl ? (
        <a
          href={nextUrl.startsWith('http') ? nextUrl : url(nextUrl)}
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded border border-brand-light-border dark:border-brand-dark-border bg-brand-light-surface dark:bg-brand-dark-surface hover:border-brand-red dark:hover:border-brand-red-neon text-brand-grey-800 dark:text-brand-grey-200 transition-colors"
          aria-label="Next Page"
        >
          <span>NEXT</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      ) : (
        <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded border border-brand-light-border/40 dark:border-brand-dark-border/40 text-brand-grey-400 dark:text-brand-grey-600 cursor-not-allowed select-none">
          <span>NEXT</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </span>
      )}
    </div>
  </nav>
)}
