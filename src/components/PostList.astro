---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';
import Pagination from './Pagination.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
  title?: string;
  subtitle?: string;
  currentPage: number;
  totalPages: number;
  prevUrl?: string;
  nextUrl?: string;
  baseUrl: string;
}

const {
  posts,
  title,
  subtitle,
  currentPage,
  totalPages,
  prevUrl,
  nextUrl,
  baseUrl,
} = Astro.props;
---

<div>
  <!-- Optional Section Header (rendered only if title is provided) -->
  {title && (
    <div class="border-b border-brand-light-border dark:border-brand-dark-border pb-4 mb-6">
      <h1 class="font-display font-bold text-2xl sm:text-3xl text-brand-grey-900 dark:text-white tracking-tight uppercase">
        {title}
      </h1>

      {subtitle && (
        <p class="text-sm sm:text-base text-brand-grey-600 dark:text-brand-grey-300 mt-1 max-w-2xl font-normal leading-relaxed">
          {subtitle}
        </p>
      )}
    </div>
  )}

  <!-- Cards Grid View -->
  {posts.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  ) : (
    <div class="py-16 text-center rounded-xl border border-dashed border-brand-light-border dark:border-brand-dark-border p-8">
      <div class="text-brand-red dark:text-brand-red-neon font-mono text-sm mb-2">[NO ENTRIES FOUND]</div>
      <p class="text-brand-grey-500 dark:text-brand-grey-400 text-sm">No entries found in this section yet.</p>
    </div>
  )}

  <!-- Pagination -->
  <Pagination
    currentPage={currentPage}
    totalPages={totalPages}
    prevUrl={prevUrl}
    nextUrl={nextUrl}
    baseUrl={baseUrl}
  />
</div>
