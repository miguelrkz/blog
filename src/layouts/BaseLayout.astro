---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../utils/url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentSection?: string;
}

const {
  title = "MiguelRKZ's blog",
  description = "A minimalist markdown blog engineered with a modern aesthetic by MiguelRKZ.",
  currentSection,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href={url('/favicon.ico?v=heart2')} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32x32.png?v=heart2')} />
    <link rel="icon" type="image/png" sizes="192x192" href={url('/favicon-192x192.png?v=heart2')} />
    <link rel="apple-touch-icon" sizes="192x192" href={url('/favicon-192x192.png?v=heart2')} />

    <!-- Google Fonts Preconnect & Stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@700;800&display=swap"
    />

    <title>{title}</title>

    <!-- Pre-render theme switcher script to prevent Flash Of Unstyled Content (FOUC) -->
    <script is:inline>
      (function () {
        const storedTheme = typeof localStorage !== 'undefined' && localStorage.getItem('theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        
        if (storedTheme === 'dark' || (!storedTheme && systemPrefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="bg-brand-light-bg dark:bg-brand-dark-bg text-brand-grey-900 dark:text-brand-grey-100 min-h-screen flex flex-col hud-grid antialiased transition-colors duration-200 selection:bg-brand-red selection:text-white">
    <Header currentSection={currentSection} />

    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 pt-3 sm:pt-4 pb-12">
      <slot />
    </main>

    <Footer />
  </body>
</html>
